{
  "name": "governr-take-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:migrate && npm run db:seed-global",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run db:migrate && npm run db:seed-global",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node db/apply-schema.js",
    "db:rebuild": "node db/drop-schema.js && npm run db:migrate && npm run db:seed-global && npm run db:seed-demo",
    "db:seed-global": "tsx scripts/populate-categories.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:typegen": "pg-to-ts generate -c \"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/governr}\" -o types/postgres.d.ts"
  },
  "dependencies": {
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pg-to-ts": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
